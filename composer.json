{
  "name": "intempt/sdk",
  "description": "Intempt PHP SDK — server-side event tracking, user identification, and analytics",
  "type": "library",
  "license": "MIT",
  "keywords": ["intempt", "analytics", "tracking", "cdp", "events"],
  "homepage": "https://github.com/intempt/php-sdk",
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Intempt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Intempt\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "config": {
    "sort-packages": true
  }
}
