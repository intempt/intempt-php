{
  "name": "intempt/sdk",
  "description": "Intempt PHP SDK — track events, identify users, and manage accounts",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Intempt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Intempt\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable"
}
